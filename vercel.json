{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "canteramanager.com" }],
      "destination": "/landing.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.canteramanager.com" }],
      "destination": "/landing.html"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app\\.canteramanager\\.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "portal\\.noladfc2015boys\\.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
